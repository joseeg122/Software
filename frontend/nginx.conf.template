server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # La API va al backend. BACKEND_URL: Docker Compose (http://backend:8080) o la URL pública del backend en la nube.
    # Con variable + resolver, nginx resuelve el nombre al atender la petición y no se cae si el backend aún no responde.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Aplicación de una sola página: cualquier ruta devuelve index.html.
    location / {
        try_files $uri /index.html;
    }
}
