{
  "info": {
    "name": "FinTrack 360 (prototipo educativo — datos simulados)",
    "description": "Todas las respuestas son datos ficticios. Define la variable \"demoPassword\" con el valor de APP_DEMO_PASSWORD y ejecuta primero \"Iniciar sesión\": el token se guarda solo en la variable \"token\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "demoUser",
      "value": "analista"
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "personId",
      "value": "1"
    },
    {
      "key": "document",
      "value": "1.000.000.001"
    }
  ],
  "item": [
    {
      "name": "Sesión",
      "item": [
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login correcto', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUser}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Perfil 360°",
      "item": [
        {
          "name": "Personas ficticias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/persons"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/persons/{{personId}}/dashboard"
          }
        },
        {
          "name": "Perfil completo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/persons/{{personId}}/profile"
          }
        },
        {
          "name": "Actualizar consulta",
          "request": {
            "method": "POST",
