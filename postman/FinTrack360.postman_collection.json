            "header": [],
            "url": "{{baseUrl}}/api/banks"
          }
        },
        {
          "name": "Catálogo de fuentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sources"
          }
        }
      ]
    },
